+
+/* Experimental prepared execution with a protocol result-format vector. */
+int
+ADBCPQsendQueryPreparedFormats(PGconn *conn, const char *stmtName,
+                              int nParams, const char *const *paramValues,
+                              const int *paramLengths, const int *paramFormats,
+                              int nResultFormats, const int *resultFormats)
+{
+    int i;
+    if (!PQsendQueryStart(conn, true))
+        return 0;
+    if (!stmtName || nParams < 0 || nParams > PQ_QUERY_PARAM_MAX_LIMIT ||
+        nResultFormats < 0 || nResultFormats > 65535 ||
+        (nResultFormats > 0 && !resultFormats))
+    {
+        libpq_append_conn_error(conn, "invalid ADBC prepared format-vector arguments");
+        return 0;
+    }
+    for (i = 0; i < nResultFormats; i++)
+    {
+        if (resultFormats[i] != 0 && resultFormats[i] != 1)
+        {
+            libpq_append_conn_error(conn, "invalid ADBC result format code");
+            return 0;
+        }
+    }
+    return PQsendQueryGutsFormats(conn, NULL, stmtName, nParams, NULL,
+                                 paramValues, paramLengths, paramFormats,
+                                 nResultFormats, resultFormats);
+}
+
+PGresult *
+ADBCPQexecPreparedFormats(PGconn *conn, const char *stmtName,
+                         int nParams, const char *const *paramValues,
+                         const int *paramLengths, const int *paramFormats,
+                         int nResultFormats, const int *resultFormats)
+{
+    if (!PQexecStart(conn))
+        return NULL;
+    if (!ADBCPQsendQueryPreparedFormats(conn, stmtName, nParams, paramValues,
+                                      paramLengths, paramFormats,
+                                      nResultFormats, resultFormats))
+        return NULL;
+    return PQexecFinish(conn);
+}
