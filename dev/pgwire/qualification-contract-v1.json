{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vahid110/arrow-adbc/dev/pgwire/qualification-contract-v1.json",
  "title": "Offline installed qualification and external host contract v1",
  "description": "Claims and signatures are untrusted. No keys or live admission are enrolled. Matching this schema does not authorize credentials, ingress, connections or paid tests.",
  "oneOf": [{"$ref": "#/$defs/Manifest"}, {"$ref": "#/$defs/Envelope"}],
  "$defs": {
    "Manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "purpose",
        "account",
        "region",
        "namespace",
        "workgroup",
        "role",
        "controls",
        "binding",
        "window",
        "cleanup",
        "tls",
        "evidence"
      ],
      "properties": {
        "version": {"const": 1},
        "purpose": {"enum": ["offline-synthetic", "dedicated-qualification"]},
        "account": {"const": "385207570137"},
        "region": {"const": "eu-north-1"},
        "namespace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "id", "arn", "database"],
          "properties": {
            "name": {"const": "adbc-qualification-20261016"},
            "id": {"type": "string", "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"},
            "arn": {
              "type": "string",
              "pattern": "^arn:aws:redshift-serverless:eu-north-1:385207570137:(?:namespace|workgroup)/[0-9a-f-]+$"
            },
            "database": {"const": "adbc_qualification"}
          }
        },
        "workgroup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "id",
            "arn",
            "namespace_id",
            "endpoint",
            "port",
            "security_group_name",
            "security_group_id"
          ],
          "properties": {
            "name": {"const": "adbc-qualification-20261016"},
            "id": {"type": "string", "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"},
            "arn": {
              "type": "string",
              "pattern": "^arn:aws:redshift-serverless:eu-north-1:385207570137:(?:namespace|workgroup)/[0-9a-f-]+$"
            },
            "namespace_id": {"type": "string", "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"},
            "endpoint": {"const": "adbc-qualification-20261016.385207570137.eu-north-1.redshift-serverless.amazonaws.com"},
            "port": {"const": 5439},
            "security_group_name": {"const": "adbc-qualification-20261016"},
            "security_group_id": {"type": "string", "pattern": "^sg-[0-9a-f]{17}$"}
          }
        },
        "role": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "arn",
            "oidc_provider",
            "audience",
            "subject",
            "policy_sha256",
            "trust_sha256",
            "authorization_resources"
          ],
          "properties": {
            "arn": {"const": "arn:aws:iam::385207570137:role/adbc-isolated-qualification-ci"},
            "oidc_provider": {"const": "arn:aws:iam::385207570137:oidc-provider/token.actions.githubusercontent.com"},
            "audience": {"const": "sts.amazonaws.com"},
            "subject": {"const": "repo:vahid110/arrow-adbc:ref:refs/heads/feature/pgwire-core-redshift"},
            "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "trust_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "authorization_resources": {"type": "array", "items": {"type": "string"}}
          }
        },
        "controls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base_rpu",
            "max_rpu",
            "automatic_optimization",
            "capacity_growth",
            "usage_limit_id",
            "usage_workgroup_arn",
            "usage_period",
            "usage_rpu_hours",
            "usage_action",
            "incremental_usd",
            "query_seconds",
            "compute_seconds",
            "paid_retries"
          ],
          "properties": {
            "base_rpu": {"const": 4},
            "max_rpu": {"const": 4},
            "automatic_optimization": {"const": false},
            "capacity_growth": {"const": false},
            "usage_limit_id": {"type": "string", "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"},
            "usage_workgroup_arn": {"type": "string", "pattern": "^arn:aws:redshift-serverless:.+$"},
            "usage_period": {"const": "daily"},
            "usage_rpu_hours": {"const": 4},
            "usage_action": {"const": "deactivate"},
            "incremental_usd": {"const": "5.00"},
            "query_seconds": {"const": 900},
            "compute_seconds": {"const": 3600},
            "paid_retries": {"const": 0}
          }
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "ref",
            "source_sha",
            "merged_sha",
            "ci_receipt_sha256",
            "independent_review_receipt_sha256",
            "run_id",
            "platform",
            "c_archive",
            "python_wheel"
          ],
          "properties": {
            "repository": {"const": "vahid110/arrow-adbc"},
            "ref": {"const": "refs/heads/feature/pgwire-core-redshift"},
            "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "merged_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "ci_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "independent_review_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "run_id": {"type": "integer", "minimum": 1},
            "platform": {"const": "ubuntu-x86_64"},
            "c_archive": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sha256", "run_id", "source_sha", "installed_tree_sha256", "entrypoint", "workflow"],
              "properties": {
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "run_id": {"type": "integer", "minimum": 1},
                "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "installed_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "entrypoint": {"const": "AdbcDriverRedshiftInit"},
                "workflow": {"const": ".github/workflows/pgwire-package.yml"}
              }
            },
            "python_wheel": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sha256", "run_id", "source_sha", "installed_tree_sha256", "entrypoint", "workflow"],
              "properties": {
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "run_id": {"type": "integer", "minimum": 1},
                "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "installed_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "entrypoint": {"const": "AdbcDriverRedshiftInit"},
                "workflow": {"type": "string", "pattern": "^\\.github/workflows/pgwire-python(?:-wheels)?\\.yml$"}
              }
            }
          }
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["not_before", "admit_before", "query_deadline", "compute_deadline", "teardown_deadline"],
          "properties": {
            "not_before": {"type": "integer", "minimum": 1},
            "admit_before": {"type": "integer", "minimum": 1},
            "query_deadline": {"type": "integer", "minimum": 1},
            "compute_deadline": {"type": "integer", "minimum": 1},
            "teardown_deadline": {"type": "integer", "minimum": 1}
          }
        },
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "external_provisioner",
            "fixture_schema",
            "ingress",
            "sessions",
            "objects",
            "verification",
            "teardown"
          ],
          "properties": {
            "owner": {"type": "string", "pattern": "^arn:aws:iam::385207570137:(?:role|user)/[A-Za-z0-9+=,.@_/-]+$"},
            "external_provisioner": {"type": "string", "pattern": "^arn:aws:iam::385207570137:(?:role|user)/[A-Za-z0-9+=,.@_/-]+$"},
            "fixture_schema": {"type": "string", "pattern": "^adbc_q_[0-9]+$"},
            "ingress": {"const": "exact-owned-rule-id-and-ipv4-/32"},
            "sessions": {"const": "close-owned"},
            "objects": {"const": "owned-fixture-only"},
            "verification": {"const": "independent-observation-required"},
            "teardown": {"const": "external-new-resources-only"}
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "hostname", "trusted_ca_sha256"],
          "properties": {
            "mode": {"const": "verify-full"},
            "hostname": {"const": "adbc-qualification-20261016.385207570137.eu-north-1.redshift-serverless.amazonaws.com"},
            "trusted_ca_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "provisioning", "usage", "cleanup", "source_artifacts"],
          "properties": {
            "kind": {"const": "external-observations-requiring-independent-verification"},
            "provisioning": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attester",
                "observed_at",
                "expires_at",
                "manifest_sha256",
                "observations_sha256",
                "review_receipt_sha256"
