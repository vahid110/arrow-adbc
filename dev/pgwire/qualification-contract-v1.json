              "properties": {
                "attester": {
                  "type": "string",
                  "pattern": "^arn:aws:iam::385207570137:(?:role|user)/[A-Za-z0-9+=,.@_/-]+$"
                },
                "observed_at": {"type": "integer", "minimum": 1},
                "expires_at": {"type": "integer", "minimum": 1},
                "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "observations_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "review_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
