              "type": "object",
              "additionalProperties": false,
              "required": [
                "attester",
                "observed_at",
                "expires_at",
                "manifest_sha256",
                "observations_sha256",
                "review_receipt_sha256"
              ],
              "properties": {
                "attester": {
                  "type": "string",
                  "pattern": "^arn:aws:iam::385207570137:(?:role|user)/[A-Za-z0-9+=,.@_/-]+$"
                },
                "observed_at": {"type": "integer", "minimum": 1},
                "expires_at": {"type": "integer", "minimum": 1},
                "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "observations_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "review_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            },
            "cleanup": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attester",
                "observed_at",
                "expires_at",
                "manifest_sha256",
                "observations_sha256",
                "review_receipt_sha256"
              ],
              "properties": {
                "attester": {
                  "type": "string",
                  "pattern": "^arn:aws:iam::385207570137:(?:role|user)/[A-Za-z0-9+=,.@_/-]+$"
                },
                "observed_at": {"type": "integer", "minimum": 1},
                "expires_at": {"type": "integer", "minimum": 1},
                "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "observations_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "review_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            },
            "source_artifacts": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attester",
                "observed_at",
                "expires_at",
                "manifest_sha256",
                "observations_sha256",
                "review_receipt_sha256"
              ],
              "properties": {
                "attester": {
                  "type": "string",
                  "pattern": "^arn:aws:iam::385207570137:(?:role|user)/[A-Za-z0-9+=,.@_/-]+$"
                },
                "observed_at": {"type": "integer", "minimum": 1},
                "expires_at": {"type": "integer", "minimum": 1},
                "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "observations_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "review_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    },
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "consumer",
        "manifest_sha256",
        "run_id",
        "observed_at",
        "expires_at",
        "nonce",
        "source",
        "artifacts",
        "resources",
        "cleanup",
