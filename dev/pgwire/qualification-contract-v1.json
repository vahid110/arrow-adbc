                "run_attempt": {"type": "integer", "minimum": 1},
                "run_conclusion": {"const": "success"},
                "artifact_name": {"type": "string", "minLength": 1},
                "library": {"type": "string", "minLength": 1},
                "module": {"type": ["string", "null"]},
